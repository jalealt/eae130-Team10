        return None
'''
    
def rho(h):
    h = 0.3048 * h  # Convert from ft to m

    rho_out = np.zeros_like(h, dtype=float)

    # Troposphere (0 - 11000m)
    mask1 = h < 11000
    T1 = 15.04 - 0.00649 * h[mask1]
    P1 = 101.29 * ((T1 + 273.1) / 288.08) ** 5.256
    rho_out[mask1] = 1000 * P1 / (287.05 * (T1 + 273.1))

    # Lower Stratosphere (11000m - 25000m)
    mask2 = (h >= 11000) & (h <= 25000)
    T2 = -56.46
    P2 = 22.65 * np.exp(1.73 - 0.000157 * h[mask2])
    rho_out[mask2] = 1000 * P2 / (287.05 * (T2 + 273.1))

    # Convert to slug/ft^3
    return rho_out * 0.00194032

h = np.linspace(0,60000,5000)
density = rho(h)

# Stall boundary
W = 62473 # lbf
CL_max = 1.4 # Cruise
S = 485 # ft^2

v = np.sqrt(2*W/(CL_max*density*S))

# Available thrust limit
CD_0 = 0.038 # Clean
e = 0.824
AR = 3
k = 1/(np.pi*e*AR)

rho_0 = density[0]
T_0 = 43000
sigma = density / rho_0
x = np.where(h < 36089, 0.7, 1.0)
# Eshelby Thrust Lapse Model
T_available = T_0*(sigma**0.7)
# Using x = 0.7 by arguing that high speed ram pressure recovery allows thrust to be maintained

A = 0.5 * density * S * CD_0
B = -T_available
C = (2 * k * W**2) / (density * S)

discriminant = B**2 - 4*A*C
flyable = discriminant >= 0 # Only plot where thrust >= drag

# Calculate the two roots: high speed and low speed
v_max = np.sqrt((-B[flyable] + np.sqrt(discriminant[flyable])) / (2 * A[flyable]))
v_min_thrust = np.sqrt((-B[flyable] - np.sqrt(discriminant[flyable])) / (2 * A[flyable]))
h_fly = h[flyable]

# Find the peak speed at the very last valid altitude
v_peak = np.sqrt(-B[flyable][-1] / (2 * A[flyable][-1]))
h_peak = h_fly[-1]

# ==========================
# SERVICE CEILING CALC
# ==========================

ROC_req = 100  # ft/min

V_test = np.linspace(100, 2000, 400)

ROC_max = []

for i in range(len(h)):

    rho_i = density[i]
    T_i = T_available[i]

    D = (0.5*rho_i*V_test**2*S*CD_0 +
         (2*k*W**2)/(rho_i*S*V_test**2))

    ROC = (T_i - D) * V_test / W

    ROC_max.append(np.max(ROC) * 60)

ROC_max = np.array(ROC_max)

# find first altitude where requirement is NOT met
idx = np.where(ROC_max <= ROC_req)[0]

if len(idx) > 0:
    h_service = h[idx[0]]
else:
    h_service = h_peak

h_absolute = h_peak
h_limit = h_absolute

v_max_final = np.append(v_max, v_peak)
v_min_final = np.append(v_min_thrust, v_peak)
h_final = np.append(h_fly, h_peak)

h_limit = h_service

mask = np.interp(h_final, h, h) <= h_service

h_final = h_final[mask]
v_max_final = v_max_final[mask]
v_min_final = v_min_final[mask]

# Recompute stall interpolation
v_stall_interp = np.interp(h_final,h,v)

v_left_boundary = np.maximum(
                    v_stall_interp,
                    v_min_final)

stall_is_restrictive = (
                        v_stall_interp
                        >=
                        v_min_final)

thrust_is_restrictive = (
                         v_min_final
                         >
                         v_stall_interp)

# Plot
# x-axis: airspeed (ft/s)
# y-axis: altitude (ft)
# Create Plot
plt.figure(figsize=(8,4))
plt.title('Flight Performance Envelope')
plt.xlabel("Airspeed (ft/s)")
plt.ylabel("Altitude (ft)")

'''
plt.plot(v, h, label = 'Stall Boundary', linestyle = '-', linewidth = 2)
plt.plot(v_min_final, h_final, label = 'Available Thrust Limit (Minimum Speed)', linestyle = '-', linewidth = 2)
'''

v_left_boundary = np.maximum(v_stall_interp, v_min_final)

stall_is_restrictive = v_stall_interp >= v_min_final
thrust_is_restrictive = v_min_final > v_stall_interp

# Plot only the part of the Stall Boundary that is the most restrictive
plt.plot(v_stall_interp[stall_is_restrictive], h_final[stall_is_restrictive], 
        linewidth=2, label='Stall Boundary')

# Plot only the part of the Min Thrust line that is the most restrictive
plt.plot(v_min_final[thrust_is_restrictive], h_final[thrust_is_restrictive], 
        linewidth=2, label='Available Thrust Limit (Minimum Speed)')

plt.plot(v_max_final, h_final, label = 'Available Thrust Limit (Maximum Speed)', linestyle = '-', linewidth = 2)

mask = h_final <= h_service

# interpolate envelope bounds at service ceiling altitude
v_left_service = np.interp(h_service, h_final, v_left_boundary)
v_right_service = np.interp(h_service, h_final, v_max_final)

plt.hlines(
    h_service,
    v_left_service,
    v_right_service,
    linewidth=2,
    color='red',
    label='Service Ceiling'
)

plt.fill_betweenx(
    h_final[mask],
    v_left_boundary[mask],
    v_max_final[mask],
    color='gray',
    alpha=0.3,
    label='Flyable Envelope'
)

plt.grid(True)
plt.legend()
plt.show()