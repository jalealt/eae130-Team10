      <CustomGeom>
        <Width Value="1.050899999999999945e+00" ID="ECLSVPBWQVD"/>
        <SeatHeight Value="3.500000000000000333e-01" ID="CALXGEKKOAJ"/>
        <SeatLength Value="1.425999999999999934e+00" ID="AWMVTLAKZTO"/>
