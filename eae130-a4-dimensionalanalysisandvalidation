# Engine Weight
def calculate_engine_weight(T_0):
    W_eng_dry = 0.521 * T_0**0.9
    W_eng_oil = 0.082 * T_0**0.65
    W_eng_rev = 0.034 * T_0
    W_eng_control = 0.26 * T_0**0.5
    W_eng_start = 9.33 * (W_eng_dry / 1000)**1.078
    return W_eng_dry + W_eng_oil + W_eng_rev + W_eng_control + W_eng_start


# Empty Weight
def calculate_empty_weight(S_wing, S_ht, S_vt, S_wet_fuselage, TOGW, T_0, num_engines):
    W_wing = S_wing * 9
    W_ht = S_ht * 4
    W_vt = S_vt * 5.3
    W_fuselage = S_wet_fuselage * 4.8
    W_landing_gear = 0.045 * TOGW

    Engine_weight = calculate_engine_weight(T_0)
    W_engines = Engine_weight * num_engines * 1.3

    W_all_else = 0.17 * TOGW

    return W_wing + W_ht + W_vt + W_fuselage + W_landing_gear + W_engines + W_all_else


# Weight Fraction
def calculate_weight_fraction(R, E, c, V):
    L_D = 0.94 * 21.5

    W1_W0 = 0.970
    W2_W1 = 0.930
    W5_W4 = 0.995

    W3_W2 = np.exp((-R * c) / (V * L_D))
    W4_W3 = np.exp((-E * c) / (L_D))

    W5_W0 = W5_W4 * W4_W3 * W3_W2 * W2_W1 * W1_W0
    return (1 - W5_W0) * 1.06


# Inner Loop Weight Convergence
def inner_loop_weight(
    TOGW_guess,
    S_wing, S_ht, S_vt, S_wet_fuselage,
    num_engines, w_crew, w_payload, T_0,
    err=1e-6,
    max_iter=200
):
    delta = np.inf
    it = 0
    history = []

    while delta > err and it < max_iter:

        Wf_W0 = calculate_weight_fraction(R, E, c, V)
        W_fuel = Wf_W0 * TOGW_guess

        W_empty = calculate_empty_weight(
            S_wing, S_ht, S_vt, S_wet_fuselage,
            TOGW_guess, T_0, num_engines
        )

        W0_new = W_empty + w_crew + w_payload + W_fuel
        history.append(W0_new)

        delta = abs(W0_new - TOGW_guess) / max(abs(W0_new), 1e-9)
        TOGW_guess = W0_new
        it += 1

    return TOGW_guess, np.array(history)

# Outer Loop Thrust Convergence
def outer_loop_thrust(S_grid):

    # Aircraft constants
    e = 0.8
    AR = 3.548
    CD_0 = 0.01136
    rho_sl = 0.00219
    rho_20k = 12.67e-4
    rho_30k = 10.66e-4

    g = 32.17

    k = 1 / (np.pi * e * AR)

    # Constraint Curves Store
    cruise_curve = []
    turn_curve = []
    dash_curve = []
    strike_curve = []
    climb_curve = []
    ceiling_curve = []
    takeoff_curve = []          # ADDED
    governing_curve = []
    weight_curve = []

    for S_wing in S_grid:

        T_total = 44000

        for _ in range(50):

            # Per-engine thrust
            T_0 = T_total

            # Converge weight
            W0, _ = inner_loop_weight(
                60000,
                S_wing, S_ht, S_vt, S_wet_fuselage,
                num_engines, W_crew, W_payload, T_0
            )

            WS = W0 / S_wing

            W_to = W0
            T_to = 0.6 * W_to
            T_cr = 0.5 * T_to

            # Cruise Constraint
            W_cr = 0.9021 * W_to
            WS_cruise = (W_cr / W_to) * WS

            v_cruise = 0.8 * 993
            q_cruise = 0.5 * rho_30k * v_cruise**2

            TW_cruise = (W_cr / W_to) / (T_cr / T_to) * (
                q_cruise * CD_0 / WS_cruise + (k / q_cruise) * WS_cruise
            )

            # Air to Air Combat Sustained Turn Constraint
            CLmax_la = 2.4

            v_stall = np.sqrt((2/(rho_sl*CLmax_la))*W_to/S_wing)
            v_turn = 1.5 * v_stall

            turn_rate = 10 / 57.3
            n_turn = np.sqrt((turn_rate * v_turn / g)**2 + 1)

            q_turn = 0.5 * rho_20k * v_turn**2
            TW_turn = q_turn * CD_0 / WS + (k * n_turn**2 / q_turn) * WS

            # Air-to-Air Combat Dash Constraint
            v_dash = 2 * 993
            q_dash = 0.5 * rho_30k * v_dash**2

            TW_atadash = (W_cr / W_to) / (T_cr / T_to) * (
                q_dash * CD_0 / WS_cruise + (k / q_dash) * WS_cruise
            )

            # Strike Dash Constraint
            v_strike = 0.9 * 1116
            q_strike = 0.5 * rho_sl * v_strike**2

            TW_strikedash = (W_cr / W_to) / (T_cr / T_to) * (
                q_strike * CD_0 / WS_cruise + (k / q_strike) * WS_cruise
            )

            # Climb Constraint
            k_s = 1.2
            CLmax_climb = 1.8
            climb_rate = 200 / 60

            TW_climb_uncorr = climb_rate/CLmax_climb*(CD_0/k)**(1/4)*(rho_sl/2)**(1/2)*(WS)**(-1/2)+2*(k*CD_0)**(1/2)
            TW_climb = (1/0.8) * TW_climb_uncorr

            # Ceiling Constraint
            TW_ceiling = 2 * np.sqrt(k * CD_0)

            # TAKEOFF CONSTRAINT (ADDED)
            CLmax_TO = 2.0
            S_TO = 1500
            sigma = 1.0
            TW_takeoff = (WS / (sigma * CLmax_TO)) * (1 / (S_TO * 0.6))

            TW_req = max(
                TW_cruise,
                TW_turn,
                TW_atadash,
                TW_strikedash,
                TW_climb,
                TW_ceiling,
                TW_takeoff
            )

            T_req = TW_req * W0

            if abs(T_req - T_total) / T_total < 1e-4:
                break

            T_total = T_req

        cruise_curve.append(TW_cruise * W0)
        turn_curve.append(TW_turn * W0)
        dash_curve.append(TW_atadash * W0)
        strike_curve.append(TW_strikedash * W0)
        climb_curve.append(TW_climb * W0)
        ceiling_curve.append(TW_ceiling * W0)
        takeoff_curve.append(TW_takeoff * W0)

        governing_curve.append(T_total)
        weight_curve.append(W0)

    return (np.array(cruise_curve),
            np.array(turn_curve),
            np.array(dash_curve),
            np.array(strike_curve),
            np.array(climb_curve),
            np.array(ceiling_curve),
            np.array(takeoff_curve),
            np.array(governing_curve),
            np.array(weight_curve))

def outer_loop_wing_area(T_grid):
    
    # Aircraft constants
    e = 0.8
    AR = 3.548
    rho_sl = 0.00219

    g = 32.17

    k = 1 / (np.pi * e * AR)

    # Constraint Curves Store
    stall_curve = []
    landing_curve = []
    governing_curve_T = []
    weight_curve_T = []

    for T_total in T_grid:

        S_req = 500

        for _ in range(50):

            S_0 = S_req

            # Converge weight
            W0, _ = inner_loop_weight(
                60000,
                S_0, S_ht, S_vt, S_wet_fuselage,
                num_engines, W_crew, W_payload, T_total
            )

            WS = W0 / S_0

            # Stall constraint (ADDED)
            CLmax_clean = 1.8
            V_stall_req = 150 * 1.687
            WS_stall = 0.5 * rho_sl * V_stall_req**2 * CLmax_clean
            S_stall = W0/WS_stall

            # Landing constraint (ADDED)
            CLmax_L = 2.6
            V_land = 130 * 1.687
            WS_land = 0.5 * rho_sl * V_land**2 * CLmax_L
            S_land = W0/WS_land

            WS_req = min(
                WS_stall,
                WS_land
            )

            S_req = 1/(WS_req)*W0

            if abs(S_req - S_0) / (S_0) < 1e-4:
                S_current = S_req
                break

            S_current = S_req

        stall_curve.append(S_stall)
        landing_curve.append(S_land)

        governing_curve_T.append(S_current)
        weight_curve_T.append(W0)

    return(np.array(stall_curve),
           np.array(landing_curve),
           np.array(governing_curve_T),
           np.array(weight_curve_T))

# Plot Section
S_ht = 173.50
S_vt = 135.86
S_wet_fuselage = 670.82
num_engines = 1

S_grid = np.arange(375, 700, 3)
T_grid = np.arange(20000, 100000, 100)

(cruise_curve,
 turn_curve,
 dash_curve,
 strike_curve,
 climb_curve,
 ceiling_curve,
 takeoff_curve,
 governing_curve,
 weight_curve) = outer_loop_thrust(S_grid)

(stall_curve,
 landing_curve,
 governing_curve_T,
 weight_curve_T) = outer_loop_wing_area(T_grid)

# Shade feasible region
# 1. Define the 'floor' (the highest performance curve at each S point)
thrust_floor = np.maximum.reduce([cruise_curve, turn_curve, dash_curve, strike_curve, climb_curve, ceiling_curve, takeoff_curve])

# 2. Define the 'ceiling' by mapping the Stall Curve (black dashed line) to your S grid
stall_limit = np.interp(S_grid, stall_curve[np.argsort(stall_curve)], T_grid[np.argsort(stall_curve)])

# 3. Add the fill line (this is the magic part)

plt.figure(figsize=(12, 7))

plt.plot(S_grid, cruise_curve, label="Cruise Constraint", linewidth=2)
plt.plot(S_grid, turn_curve, label="Sustained Turn Constraint", linewidth=2)
plt.plot(S_grid, dash_curve, label="Air-to-Air Dash Constraint", linewidth=2)
plt.plot(S_grid, strike_curve, label="Strike Dash Constraint", linewidth=2)
plt.plot(S_grid, climb_curve, label="Climb Constraint", linewidth=2)
plt.plot(S_grid, ceiling_curve, label="Ceiling Constraint", linewidth=2)
plt.plot(S_grid, takeoff_curve, label="Takeoff Constraint", linewidth=2)
plt.plot(stall_curve, T_grid, color='black', linestyle='--', linewidth=2, label="Stall Constraint")
plt.plot(landing_curve, T_grid, color='red', linestyle='-.', linewidth=2, label="Landing Constraint")

plt.plot(485, 43000, label = 'Design Point', marker = 'o')

plt.fill_between(S_grid, thrust_floor, stall_limit, where=(stall_limit > thrust_floor), color="grey", alpha=0.25, interpolate=True, label="Feasible Region")

plt.xlim(375, 700)
plt.ylim(0, 70000)

plt.title("Converged T vs. S")
plt.xlabel("Wing Area S (ft²)")
plt.ylabel("Required Thrust (lbf)")
plt.grid(True)
plt.legend(loc="center left", bbox_to_anchor=(1, 0.5))
plt.tight_layout()
plt.show()

